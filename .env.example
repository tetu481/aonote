AONOTE_ENV=production
AONOTE_DATABASE=/data/aonote.sqlite3
AONOTE_BASE_URL=https://notes.example.com
AONOTE_ADMIN_PASSWORD=replace-with-a-long-random-password
AONOTE_DEV_BYPASS_AUTH=false
# Maximum failed password attempts per source IP within 15 minutes (default 5).
# Reaching the limit blocks browser/OAuth logins from that IP for 15 minutes.
AONOTE_LOGIN_MAX_ATTEMPTS=5
# Behind a reverse proxy, set Uvicorn's trusted proxy IPs/networks explicitly.
# Trust only your actual proxies, never arbitrary clients; see README.md.
# FORWARDED_ALLOW_IPS=127.0.0.1
AONOTE_MAX_FOLDER_DEPTH=3
# Remember the last open note and view in this tab (hours, positive integer).
AONOTE_WORKSPACE_SESSION_HOURS=1
# Readiness fails below this free space (MiB); monitoring logs status changes.
AONOTE_MIN_FREE_DISK_MB=100
AONOTE_MONITOR_INTERVAL_SECONDS=60
