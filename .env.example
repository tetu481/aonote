AONOTE_ENV=production
AONOTE_DATABASE=/data/aonote.sqlite3
AONOTE_BASE_URL=https://notes.example.com
AONOTE_ADMIN_PASSWORD=replace-with-a-long-random-password
AONOTE_DEV_BYPASS_AUTH=false
AONOTE_MAX_FOLDER_DEPTH=3
# Readiness fails below this free space (MiB); monitoring logs status changes.
AONOTE_MIN_FREE_DISK_MB=100
AONOTE_MONITOR_INTERVAL_SECONDS=60
